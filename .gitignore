# Ignorar todos los archivos CSV
*.csv

# No ignorar la carpeta datasets y su contenido
!news_scraper/datasets/

# No ignorar .py y .ipynb en news_scraper/
!news_scraper/news_scraper/*.py
!news_scraper/news_scraper/*.ipynb

# Ignorar caché de Python
__pycache__/
*.pyc

# Ignorar configuraciones locales
config_urls.py
scrapy.cfg

